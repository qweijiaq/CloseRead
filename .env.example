# Optional: enable LLM-powered extraction, notes and translations.
# You can also configure this in the web UI (模型设置); that saves to data/llm.json.
# Providers: anthropic | openai | deepseek | google | alibaba | xai | glm | moonshot | opencode | opencode-go | open-design | custom
# LEARN_PROVIDER=openai

# Generic key for any OpenAI-compatible provider.
LEARN_API_KEY=

# Or use a provider-specific key. The provider is detected automatically when
# LEARN_PROVIDER is not set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# DASHSCOPE_API_KEY=
# XAI_API_KEY=
# GLM_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=

# Override the provider defaults only when needed (especially for custom).
# LEARN_BASE_URL=https://api.openai.com/v1
# LEARN_MODEL=gpt-4o-mini

# Optional: load keys from another local env file at runtime (not copied into this repo).
# LEARN_ENV_FILE=/path/to/another/project/.env

# Default learner level used when selecting items.
LEARN_LEVEL=B2

# Default style. If styles/unified.md exists it is used automatically.
# LEARN_STYLE=unified
# Use `LEARN_STYLE=none` to disable the default style.

# Where the library, resources and generated packs live.
# LEARN_DATA_DIR=./data
# LEARN_PACKS_DIR=./packs

# Bind address for the web review server. Keep loopback unless a trusted
# reverse proxy is in front of it.
# LEARN_HOST=127.0.0.1
# Setting LEARN_PUBLIC_HOST enables public mode: every browser gets its own
# anonymous workspace (data/users/<id>/), reads before the first write come from
# the shared read-only demo, and no visitor can see another visitor's data.
# Comma-separate extra hostnames served by the same deployment.
# LEARN_PUBLIC_HOST=closeread.example.com

# Required once LEARN_PUBLIC_HOST is set: encrypts stored provider keys at rest.
# Use at least 16 characters and keep it with your backups. Changing it makes
# previously stored keys unreadable.
# LEARN_SECRET=

# Optional: opening /?owner=<key> pins one stable workspace across browsers,
# so the site owner is not just another anonymous visitor.
# LEARN_OWNER_KEY=

# Optional: pin the phone-access token (otherwise a new one is generated on each enable).
# LEARN_ACCESS_TOKEN=

# Optional: neural text-to-speech. Providers: local | edge | glm | gemini | minimax | elevenlabs | openai | custom.
# You can also configure this in the pack's 音频跟读 → 语音设置 panel; that saves
# the key to data/tts.json (mode 0600) and never returns it to the page.
# LEARN_TTS_PROVIDER=glm
# OPENAI_TTS_API_KEY=
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# OPENAI_TTS_INSTRUCTIONS=Read like a thoughtful magazine narrator: warm, unhurried, with natural pauses.
