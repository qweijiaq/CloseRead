# Optional: enable LLM-powered extraction, sense disambiguation and Chinese explanations.
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Moonshot, Qwen, a local gateway, ...).
LEARN_API_KEY=
LEARN_BASE_URL=https://api.openai.com/v1
LEARN_MODEL=gpt-4o-mini

# Optional: load keys from another local env file at runtime (not copied into this repo).
# LEARN_ENV_FILE=/path/to/another/project/.env

# If only DEEPSEEK_API_KEY is available, the compiler uses
# https://api.deepseek.com/v1 + deepseek-chat automatically.
# DEEPSEEK_API_KEY=

# Default learner level used when selecting items.
LEARN_LEVEL=B2

# Default style. If styles/unified.md exists it is used automatically.
# LEARN_STYLE=unified
# Use `LEARN_STYLE=none` to disable the default style.

# Where the library, resources and generated packs live.
# LEARN_DATA_DIR=./data
# LEARN_PACKS_DIR=./packs
